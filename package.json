{
  "name": "agenda-consultorios",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel:build": "next build && npm run db:deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:search": "tsx scripts/bench-patient-search.ts",
    "inngest:dev": "npx --yes inngest-cli@1.49.0 dev -u http://localhost:3000/api/inngest --no-discovery",
    "conta:criar": "tsx scripts/create-account.ts",
    "operador:saude": "tsx scripts/operator-health.ts",
    "whatsapi:setup": "tsx scripts/whatsapi-setup.ts",
    "whatsapi:reply": "tsx scripts/simulate-reply.ts",
    "google:sandbox": "tsx scripts/google-sandbox.ts",
    "crm:sandbox": "tsx scripts/crm-sandbox.ts",
    "flwchat:setup": "tsx scripts/flwchat-setup.ts",
    "push:sandbox": "tsx scripts/push-sandbox.ts",
    "email:teste": "tsx scripts/email-test.ts",
    "check": "prisma validate && npm run lint && npm run typecheck && npm run test",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/assert-local-database.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/assert-local-database.ts && prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "googleapis": "186.0.0",
    "inngest": "4.26.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "nodemailer": "10.1.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
