# Copie para .env e preencha. O .env não vai para o git.

# Banco local (npm run db:up sobe o Postgres do docker-compose.yml)
DATABASE_URL="postgresql://agenda:agenda@127.0.0.1:5432/agenda?schema=public"
# Banco dos testes: recriado a cada `npm test`. O nome precisa terminar em _test.
DATABASE_URL_TEST="postgresql://agenda:agenda@127.0.0.1:5432/agenda_test?schema=public"
# Em produção (D-97, docs/publicacao.md): DATABASE_URL é o transaction pooler do Supabase (porta 6543) e DIRECT_URL,
# o das migrações, é o session pooler (porta 5432). Localmente, deixe vazio: as migrações usam DATABASE_URL.
DIRECT_URL=""
# Banco remoto só com TLS: o certificado de Database settings > SSL. Sem ele, só com sslmode escrito na URL.
DATABASE_CA_CERT=""
# Conexões por instância em banco remoto (padrão 5).
DATABASE_POOL_MAX=""

# Auth (Bloco 2, Better Auth). Gere o segredo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# No preview da Vercel, deixe BETTER_AUTH_URL vazio: vale o endereço do ramo (D-95).

# Google OAuth: o login pede só identidade; o vínculo da agenda é um fluxo separado (D-01), com o mesmo cliente.
# Vazio, o botão "Entrar com Google" não aparece. Redirect URIs do cliente:
#   <BETTER_AUTH_URL>/api/auth/callback/google (login) e <BETTER_AUTH_URL>/api/google/oauth/callback (vínculo da agenda)
# No projeto do Google Cloud, ative a Google Calendar API e, com o app em Testing, cadastre os usuários de teste (D-65).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Agenda (Bloco 6, D-58): "sandbox" (padrão fora de produção) usa o Google falso das tabelas SandboxGoogle*;
# "google" fala com o Google. Produção sempre usa o Google. Fora de produção, o Google de verdade só vincula as contas
# desta lista (vírgulas): contas de teste, nunca a de um profissional.
GOOGLE_CALENDAR_PROVIDER="sandbox"
GOOGLE_ALLOWED_ACCOUNTS=""

# Chave de 32 bytes em base64 para criptografar refresh tokens do Google e tokens de provedores
TOKEN_ENCRYPTION_KEY=""

# WhatsAPI (Bloco 5, D-51). Em produção, URL, token e número são informados na tela do profissional e ficam por
# instância no banco, com o token criptografado (D-94);
# estes são da instância de teste, usados por `npm run whatsapi:setup`. Número de teste, nunca o de um profissional.
WHATSAPI_API_URL=""
WHATSAPI_TOKEN=""
# "sandbox" (padrão fora de produção) grava as mensagens na tabela SandboxMessage; "whatsapi" envia de verdade.
# Produção sempre usa "whatsapi". Fora de produção, preview da Vercel incluído (D-95), o envio real só alcança os números desta lista (vírgulas).
MESSAGING_PROVIDER="sandbox"
MESSAGING_ALLOWED_NUMBERS=""

# SynkronosCRM pelo FlwChat (Bloco 7, D-66). Em produção, o token é informado na tela Configurações e guardado
# criptografado, um por conta da Synkronos (D-73); FLWCHAT_TOKEN é só o usado por `npm run flwchat:setup`.
FLWCHAT_API_URL="https://api.wts.chat"
FLWCHAT_TOKEN=""
# "sandbox" (padrão fora de produção) usa o CRM falso das tabelas SandboxCrm*; "flwchat" fala com o FlwChat.
# Produção sempre usa o FlwChat. Fora de produção, o cliente real só alcança os contatos desta lista (celulares,
# vírgulas): contatos de teste, nunca um paciente nem o número de um profissional.
CRM_PROVIDER="sandbox"
CRM_ALLOWED_CONTACTS=""

# Web Push da PWA do profissional (Bloco 8, D-78). "sandbox" (padrão fora de produção) grava os avisos na tabela
# SandboxPushMessage; "webpush" entrega de verdade. Produção sempre entrega. Fora de produção, a entrega real só alcança
# os usuários desta lista (e-mails, vírgulas). Gere as chaves uma vez por ambiente com: npx web-push generate-vapid-keys
# Trocar as chaves depois invalida as assinaturas de todos os aparelhos. Sem VAPID_PUBLIC_KEY, a tela não oferece os avisos.
PUSH_PROVIDER="sandbox"
PUSH_ALLOWED_USERS=""

# E-mail (D-90): convites, link do Google e senha esquecida. Sem EMAIL_PROVIDER, em
# desenvolvimento a mensagem sai no terminal e em produção o envio falha.
# "gmail" usa a senha de app da conta (Conta Google > Segurança > Senhas de app, com a
# verificação em duas etapas ligada). Fora de produção, só alcança a lista abaixo.
# Confira com: npm run email:teste -- --para voce@exemplo.com
EMAIL_PROVIDER=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
EMAIL_FROM_NAME="Agenda"
EMAIL_ALLOWED_RECIPIENTS=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@example.com"

# Inngest (Bloco 5, D-54). Em desenvolvimento, INNGEST_DEV=1 e `npm run inngest:dev`, sem conta;
# em produção, as chaves do Inngest Cloud.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# URL HTTPS pública para webhooks: o domínio de produção, ou em desenvolvimento um túnel ou preview da Vercel (D-24).
# Sem ela, o Google não manda push e só o polling de 4 min lê os calendários (D-61), e a tela não registra instância
# real de WhatsApp, porque as respostas não chegariam (D-94).
PUBLIC_WEBHOOK_URL=""
